            cgpa: 8.75,
            icon: Icons.computer,
          ),

          StudentCard(
            studentName: "Priya Sharma",
            branch: "Information Technology",
            cgpa: 9.10,
            icon: Icons.laptop,
          ),

          StudentCard(
            studentName: "Rahul Raj",
            branch: "Mechanical Engineering",
            cgpa: 8.25,
            icon: Icons.engineering,
          ),
        ],
      ),
    );
  }
}
